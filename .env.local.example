# ローカル開発用の環境変数テンプレート
# このファイルを .env.local という名前でコピーして、値を埋めてください。
# .env.local は git に入りません（コミットしないでください）

# --- Firebase（Firebaseコンソール → プロジェクトの設定 → マイアプリ で確認） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- 運営画面 ---
# 運営ダッシュボードのログインパスワード（自分で決める / Vercelと揃える）
ORGANIZER_PASSWORD=
# ログイン状態を保持するcookieの中身。ランダムな長い文字列にすること。
# 生成コマンド:  openssl rand -hex 32
ORGANIZER_SESSION_SECRET=
# 景品交換係だけに配る別パスワード（任意。空なら ORGANIZER_PASSWORD が使われる）
REWARD_STAFF_PASSWORD=
